{
  "name": "2025-node-api",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "node --import tsx --watch index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test.unit": "vitest run --reporter=verbose */**/*.unit.test.ts",
    "test.integration": "vitest run --reporter=verbose src/*.integration.test.ts",
    "test.e2e": "vitest run --reporter=verbose *.e2e.test.ts",
    "test.watch": "vitest --watch",
    "test.coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{ts,js,mjs,json,md,html}'"
  },
  "author": "Michael Czechowski <mail@m6c9.de>",
  "license": "WTFPL",
  "description": "Modern Node.js API with TypeScript, ES modules and Vitest",
  "nodemonConfig": {
    "env": {
      "DEBUG": "router:*",
      "PORT": "3333"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "express": "^5.2.1",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.8"
  }
}
